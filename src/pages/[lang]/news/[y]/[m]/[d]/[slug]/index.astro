---
import { getCollection } from 'astro:content';
import Layout from '../../../../../../../layouts/Layout.astro';
import Post from '../../../../../../../components/Post.astro';
import { postInfo } from '../../../../../../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => {
    const { lang, y, m, d, slug } = postInfo(post);
    // A post with the same date-slug file in the other language is its translation
    const file = post.id.split('/')[1];
    const pair = posts.filter((p) => p.id.split('/')[1] === file);
    const langUrls = pair.length > 1 ? Object.fromEntries(pair.map((p) => [postInfo(p).lang, postInfo(p).url])) : undefined;
    return { params: { lang, y, m, d, slug }, props: { post, langUrls } };
  });
}
const { post, langUrls } = Astro.props;
---
<Layout lang={postInfo(post).lang} title={post.data.title} langUrls={langUrls}>
  <div id="content-wrap">
    <div class="wrapper">
      <div class="inner">
        <Post post={post} />
      </div>
    </div>
  </div>
</Layout>
